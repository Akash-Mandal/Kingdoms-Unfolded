Scenarios="*res://scripts/core/scenarios.gd"
Succession="*res://scripts/core/succession.gd"
KeyVault="*res://scripts/net/key_vault.gd"
Chronicle="*res://scripts/net/chronicle.gd"
NarrativeProvider="*res://scripts/net/narrative_provider.gd"
GraphicsSettings="*res://scripts/core/graphics_settings.gd"
SaveSlots="*res://scripts/core/save_slots.gd"
Analytics="*res://scripts/core/analytics.gd"
Sfx="*res://scripts/audio/sfx.gd"
Music="*res://scripts/audio/music.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=0

[input_devices]

pointing/emulate_touch_from_mouse=false

[input]
ui_accept={
