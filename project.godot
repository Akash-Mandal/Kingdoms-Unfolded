; Engine configuration file.
; Engine version: 4.7.2
; Project: Kingdoms Unfolded

config_version=5

[application]

config/name="Kingdoms Unfolded"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.10196, 0.07059, 0.03137, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/splash/splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=false

[autoload]

Game="*res://scripts/core/game.gd"
TimeClock="*res://scripts/core/time_clock.gd"
